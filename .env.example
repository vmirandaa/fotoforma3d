# Crea una clave en el panel de Hyper3D / Rodin y guárdala solo en este archivo local.
RODIN_API_KEY=pega_aqui_tu_clave_privada

# Nivel de detalle de la vista previa gratuita: Gen-2.5-Low, Gen-2.5-Medium o Gen-2.5-High.
PREVIEW_TIER=Gen-2.5-Medium

# Máximo de vistas previas por hora desde una misma IP (0 = sin límite).
PREVIEW_LIMIT_PER_HOUR=6
