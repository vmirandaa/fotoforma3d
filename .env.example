# Crea una clave en el panel de Hyper3D / Rodin y guárdala solo en este archivo local.
RODIN_API_KEY=pega_aqui_tu_clave_privada

# Nivel de detalle de la vista previa gratuita: Gen-2.5-Low, Gen-2.5-Medium o Gen-2.5-High.
PREVIEW_TIER=Gen-2.5-Medium

# Máximo de vistas previas por hora desde una misma IP (0 = sin límite).
PREVIEW_LIMIT_PER_HOUR=6

# Clave del panel privado de reservas (admin.html). Sin este valor el panel queda desactivado.
ADMIN_PASSWORD=

# Avisos por correo de cada reserva (uno para ti y una confirmación para el cliente).
# Con Gmail: activa la verificación en dos pasos, crea una "contraseña de aplicación" y úsala en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcionales: remitente que ve el cliente y casilla donde llegan los avisos. Por defecto, SMTP_USER.
MAIL_FROM=
NOTIFY_TO=
