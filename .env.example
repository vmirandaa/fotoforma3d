# --- Servicio 3D: Tripo (https://developers.tripo3d.ai) ---
# Clave de la API de Tripo. Guárdala solo en este archivo local.
TRIPO_API_KEY=pega_aqui_tu_clave_privada
# Opcional: versión del modelo de Tripo (por defecto v3.1-20260211).
TRIPO_MODEL=
# Opcional: false genera sin colores (20 créditos en vez de 30); el visor solo podrá mostrarla en blanco
# y el taller no tendrá la referencia de colores para pintarla.
TRIPO_TEXTURE=

# Límites de vistas previas (cada una cuesta créditos). 0 = sin límite.
# Por conexión: máximo por hora y por día.
PREVIEW_LIMIT_PER_HOUR=6
PREVIEW_LIMIT_PER_DAY=15
# Total del sitio en 24 horas, sumando a todos los visitantes: acota el gasto aunque lleguen muchas visitas o un ataque.
PREVIEW_DAILY_BUDGET=100

# Ponlo en true al publicar el servidor detrás de un servicio como Render o Railway, para que los límites
# usen la dirección real de cada visitante y no la del servicio. En tu computador déjalo vacío.
TRUST_PROXY=

# Cuenta de administrador para el panel de reservas (se ingresa en ingresar.html). Sin estos dos valores el panel queda desactivado.
ADMIN_USER=
ADMIN_PASSWORD=

# Avisos por correo de cada reserva (uno para ti y una confirmación para el cliente).
# Con Gmail: activa la verificación en dos pasos, crea una "contraseña de aplicación" y úsala en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcionales: remitente que ve el cliente y casilla donde llegan los avisos. Por defecto, SMTP_USER.
MAIL_FROM=
NOTIFY_TO=
