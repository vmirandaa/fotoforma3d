{
  "name": "forma-estudio-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server.mjs",
    "build:css": "sass scss/main.scss css/main.css --no-source-map --style=expanded",
    "watch:css": "sass scss/main.scss css/main.css --no-source-map --style=expanded --watch",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "check": "npm run lint && prettier --check \"**/*.{js,mjs}\" && npm test"
  },
  "dependencies": {
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2"
  }
}
